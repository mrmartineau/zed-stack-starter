# Neon Postgres. Use the direct (not pooled) URL; Hyperdrive does the pooling.
# DATABASE_URL: used by drizzle-kit (db:generate, db:migrate, db:studio).
# CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE: used by the Worker in local dev
#   for the HYPERDRIVE binding. Deployed Workers use the Hyperdrive config in wrangler.jsonc.
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Better-auth
# Running `openssl rand -hex 32` to generate a random 32-byte hex string is recommended
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3450

# Optional: comma-separated list of trusted origins
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3450

# Optional: set to "true" to disable signups (login only)
# BETTER_AUTH_DISABLE_SIGNUP=false
