{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/@mrmartineau/kit/src/oxlint/.oxlintrc.json"
  ],
  "ignorePatterns": [
    "**/dist",
    "src/routeTree.gen.ts",
    "worker-configuration.d.ts",
    "drizzle",
    "public"
  ],
  "rules": {
    "no-console": [
      "error",
      {
        "allow": [
          "warn",
          "error"
        ]
      }
    ]
  }
}
